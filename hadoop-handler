        if [ "$i" -eq "$selected" ]; then
            printf "\033[2K  %b▶%b %b[ %d ] %s%b\n" "$BCYAN" "$NC" "$BGREEN" "$i" "${MENU_OPTIONS[$i]}" "$NC"
        else
            printf "\033[2K    %b[ %d ]%b %s\n" "$GRAY" "$i" "$NC" "${MENU_OPTIONS[$i]}"
        fi
    done
    printf "\033[2K%b\n" "$DIVIDER"
    printf "\033[2K  %bUse [↑/↓] (or j/k) and [Enter] to select, or press [0-%d] directly%b\n" "$GRAY" "$((num_options - 1))" "$NC"
}

# Arrow-Key Navigation Menu Selector (Zero Flicker)
select_menu_option() {
    MENU_CHOICE=""
    local selected=0
    local key=""
    local num_options=${#MENU_OPTIONS[@]}
    local lines_count=$((num_options + 2))

    # Fallback to plain prompt if stdin is not a TTY (for piping/scripting)
    if [ ! -t 0 ]; then
        clear
        show_banner_and_status
        echo -e "$DIVIDER"
        for i in "${!MENU_OPTIONS[@]}"; do
            echo -e "  [ $i ] ${MENU_OPTIONS[$i]}"
        done
        echo -e "$DIVIDER"
        read -r choice || choice=9
        MENU_CHOICE="${choice:-9}"
        return 0
    fi

    # Clear once at start of menu session
    clear
    show_banner_and_status
    echo -e "$DIVIDER"

    # Hide cursor
    tput civis 2>/dev/null || printf "\033[?25l"
    trap 'tput cnorm 2>/dev/null || printf "\033[?25h"' RETURN EXIT INT TERM

    # Initial render of options
    render_options "$selected"

    while true; do
        IFS= read -rsn1 key
        local old_selected=$selected

        if [ "$key" = $'\x1b' ]; then
            read -rsn2 -t 0.1 rest
            key+="$rest"
            case "$key" in
                $'\x1b[A'|$'\x1bOA') # Up arrow
                    ((selected--))
                    [ $selected -lt 0 ] && selected=$((num_options - 1))
                    ;;
                $'\x1b[B'|$'\x1bOB') # Down arrow
                    ((selected++))
                    [ $selected -ge $num_options ] && selected=0
                    ;;
            esac
        elif [ "$key" = "k" ] || [ "$key" = "K" ]; then
            ((selected--))
            [ $selected -lt 0 ] && selected=$((num_options - 1))
        elif [ "$key" = "j" ] || [ "$key" = "J" ]; then
            ((selected++))
            [ $selected -ge $num_options ] && selected=0
        elif [ -z "$key" ] || [ "$key" = $'\n' ]; then
            break
        elif [[ "$key" =~ ^[0-9]$ ]] && [ "$key" -lt "$num_options" ]; then
            selected="$key"
            break
        elif [ "$key" = "q" ] || [ "$key" = "Q" ]; then
            selected=$((num_options - 1))
            break
        fi

        # In-place redraw without screen clearing (smooth, zero-flicker)
        if [ "$selected" -ne "$old_selected" ]; then
            printf "\033[%dA" "$lines_count"
            render_options "$selected"
        fi
    done

    # Restore cursor
    tput cnorm 2>/dev/null || printf "\033[?25h"
    MENU_CHOICE="$selected"
}

# Load environment on launch
load_env

# CLI Subcommands & Flags
if [ -n "$1" ]; then
    case "$1" in
        0|diagnose|repair)
            diagnose_and_repair
            exit $?
            ;;
        1|install)
            install_hadoop
            exit $?
            ;;
        2|verify|status)
            verify_hadoop
            exit $?
            ;;
        3|start)
            start_services
            exit $?
            ;;
        4|stop)
            stop_services
            exit $?
            ;;
        restart)
            stop_services
            sleep 2
            start_services
            exit $?
            ;;
        5|delete)
            delete_hadoop
            exit $?
            ;;
        6|service)
            shift
            manage_system_service "$@"
            exit $?
            ;;
        7|update|self-update)
            self_update
            exit $?
            ;;
        8|completion)
            shift
            install_shell_completion "$@"
            exit $?
            ;;
        --install-completion)
            install_shell_completion
            exit $?
            ;;
        menu)
            # Fall through to interactive loop
            ;;
        -v|--version)
            echo "hadoop-handler ${CURRENT_VERSION}"
            exit 0
            ;;
        -h|--help)
            echo "Hadoop Handler v${CURRENT_VERSION} — Single-Node Cluster Control Center"
            echo "Usage: hadoop-handler [command] [options]"
            echo ""
            echo "Commands:"
            echo "  (no args)               Launch interactive TUI control panel"
            echo "  diagnose                Diagnose/Repair system dependencies"
            echo "  install                 Install and configure Apache Hadoop 3.4.2"
            echo "  verify, status          Check Hadoop and Java status and running daemons"
            echo "  start                   Start Hadoop services (HDFS & YARN)"
            echo "  stop                    Stop Hadoop services"
            echo "  restart                 Restart all cluster daemons"
            echo "  delete                  Delete Hadoop cluster installation completely"
            echo "  service <action>        Manage system service (enable|disable|status|start|stop)"
            echo "  update                  Check and perform in-place self-update"
            echo "  completion <shell>      Generate autocompletion script (bash|zsh|fish|powershell)"
            echo "  --install-completion    Automatically install autocompletion for current shell"
            echo "  -v, --version           Show version"
            echo "  -h, --help              Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown command: $1"
            echo "Run 'hadoop-handler --help' for usage."
            exit 1
            ;;
    esac
fi

# Interactive Menu Loop
while true; do
    select_menu_option
    
    case $MENU_CHOICE in
        0)
            diagnose_and_repair
            pause_screen
            ;;
        1)
            install_hadoop
            pause_screen
            ;;
        2)
            verify_hadoop
            pause_screen
            ;;
        3)
            start_services
            pause_screen
            ;;
        4)
            stop_services
            pause_screen
            ;;
        5)
            delete_hadoop
            pause_screen
            ;;
        6)
            manage_system_service
            pause_screen
            ;;
        7)
            self_update
            pause_screen
            ;;
        8)
            install_shell_completion
            pause_screen
            ;;
        9)
            clear
            echo -e "\n  Exiting Hadoop Handler. Goodbye!"
            exit 0
            ;;
        *)
            echo -e "  ${RED}[!] Invalid choice.${NC}"
            sleep 1.2
            ;;
    esac
done
