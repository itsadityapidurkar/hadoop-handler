# Interactive Menu Loop
load_env

while true; do
    clear
    show_menu
    read -p "  Select an option [1-6]: " choice
    
    case $choice in
        1)
            install_hadoop
            pause_screen
            ;;
        2)
            verify_hadoop
            pause_screen
            ;;
        3)
            start_services
            pause_screen
            ;;
        4)
            stop_services
            pause_screen
            ;;
        5)
            delete_hadoop
            pause_screen
            ;;
        6)
            clear
            echo -e "\n  Exiting Hadoop Handler. Goodbye!"
            exit 0
            ;;
        *)
            echo -e "  ${RED}[!] Invalid choice. Please select [1-6].${NC}"
            sleep 1.5
            ;;
    esac
done
