# 3. Start Hadoop Services
start_services() {
    clear
    load_env
    echo -e "$DIVIDER"
    echo -e "  ${BCYAN}ACTION: Starting Hadoop Services (HDFS & YARN)${NC}"
    echo -e "$DIVIDER\n"
    
    if [ -z "$HADOOP_HOME" ] || [ ! -d "$HADOOP_HOME" ]; then
        echo -e "  ${RED}[!] Error: Hadoop is not installed. Please run Option 1 first.${NC}"
        return
    fi

    # Compatibility pre-flight check
    check_compatibility "" ""

    # Start HDFS (NameNode, DataNode, SecondaryNameNode)
    echo -e "\n  ${GRAY}[1/2]${NC} Starting Distributed File System (HDFS)..."
    if command -v start-dfs.sh >/dev/null 2>&1; then
        start-dfs.sh
    else
        "${HADOOP_HOME}/sbin/start-dfs.sh"
    fi

    # Start YARN (ResourceManager, NodeManager)
    echo -e "\n  ${GRAY}[2/2]${NC} Starting YARN Resource Negotiator..."
    if command -v start-yarn.sh >/dev/null 2>&1; then
        start-yarn.sh
    else
        "${HADOOP_HOME}/sbin/start-yarn.sh"
    fi

    echo -e "\n  ${GREEN}[✓] Active Hadoop daemons after startup:${NC}"
    echo -e "  $DIVIDER"
    if command -v jps >/dev/null 2>&1; then
        jps | sed 's/^/  /'
    fi
    send_notification "Hadoop Handler" "Hadoop cluster services (HDFS & YARN) started."
}

# 4. Stop Hadoop Services
stop_services() {
    clear
    load_env
    echo -e "$DIVIDER"
    echo -e "  ${BCYAN}ACTION: Stopping Hadoop Services (YARN & HDFS)${NC}"
    echo -e "$DIVIDER\n"
    
    if [ -z "$HADOOP_HOME" ] || [ ! -d "$HADOOP_HOME" ]; then
        echo -e "  ${RED}[!] Error: Hadoop is not installed.${NC}"
        return
    fi

    # Stop YARN
    echo -e "  ${GRAY}[1/2]${NC} Stopping YARN Resource Manager & Nodes..."
    if command -v stop-yarn.sh >/dev/null 2>&1; then
        stop-yarn.sh
    else
        "${HADOOP_HOME}/sbin/stop-yarn.sh"
    fi

    # Stop HDFS
    echo -e "\n  ${GRAY}[2/2]${NC} Stopping Distributed File System (HDFS)..."
    if command -v stop-dfs.sh >/dev/null 2>&1; then
        stop-dfs.sh
    else
        "${HADOOP_HOME}/sbin/stop-dfs.sh"
    fi

    echo -e "\n  ${GREEN}[✓] Remaining active daemons:${NC}"
    echo -e "  $DIVIDER"
    if command -v jps >/dev/null 2>&1; then
        jps | sed 's/^/  /'
    fi
    send_notification "Hadoop Handler" "Hadoop cluster services stopped."
}

# 5. Delete Hadoop Completely
delete_hadoop() {
    clear
    echo -e "$DIVIDER"
    echo -e "  ${BRED}ACTION: Completely Uninstalling Hadoop${NC}"
    echo -e "$DIVIDER\n"
    
    echo -e "  ${RED}[!] WARNING: This will permanently delete your Hadoop installation,${NC}"
    echo -e "  ${RED}    configuration files, HDFS directories, and path profiles.${NC}\n"
    read -p "  Are you sure you want to proceed? (y/N): " confirm
    
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        load_env
        
        stop_services >/dev/null 2>&1 || true
        
        echo -e "\n  ${GRAY}[1/3]${NC} Deleting binaries and directories..."
        if [ -d "$HADOOP_HOME" ]; then
            if [ "$OS_NAME" = "Linux" ]; then
                sudo rm -rf "$HADOOP_HOME" /opt/hadoop_data /opt/hadoop_tmp
            else
                rm -rf "$HADOOP_HOME" ~/hadoopdata ~/hadooptmp /Users/Shared/hadoop /Users/Shared/hadoop_data /Users/Shared/hadoop_tmp
            fi
            echo -e "        Deleted ${HADOOP_HOME} and data directories."
        fi

        echo -e "\n  ${GRAY}[2/3]${NC} Removing downloaded archives..."
        rm -f "$HOME"/Downloads/hadoop-*.tar.gz
        echo -e "        Removed tarball cache."

        echo -e "\n  ${GRAY}[3/3]${NC} Cleaning up environment variables..."
        for profile in "$HOME/.bashrc" "$HOME/.zshrc"; do
            if [ -f "$profile" ]; then
                sed -i.bak '/# --- HADOOP HANDLER ENVIRONMENT VARIABLES ---/,/export PATH=.*HADOOP/d' "$profile" 2>/dev/null || \
                sed -i '' '/# --- HADOOP HANDLER ENVIRONMENT VARIABLES ---/,/export PATH=.*HADOOP/d' "$profile" 2>/dev/null
                rm -f "${profile}.bak"
                echo -e "        Cleaned environment variables from ${profile}."
            fi
        done

        unset HADOOP_HOME HADOOP_CONF_DIR HADOOP_COMMON_HOME HADOOP_HDFS_HOME HADOOP_MAPRED_HOME YARN_HOME HADOOP_COMMON_LIB_NATIVE_DIR

        echo -e "\n  ${GREEN}[✓] Uninstall completed. Please reload your shell profile:${NC}"
        echo -e "      ${YELLOW}source ~/.bashrc${NC} (or ${YELLOW}source ~/.zshrc${NC})"
        send_notification "Hadoop Handler" "Hadoop installation uninstalled."
    else
        echo -e "  ${YELLOW}Uninstall aborted.${NC}"
    fi
}

# 6. System Service Integration (systemd / launchd)
manage_system_service() {
    local action="$1"
    
    if [ "$OS_NAME" = "Linux" ]; then
        local unit_dir="$HOME/.config/systemd/user"
        local unit_file="${unit_dir}/hadoop.service"
        local hadoop_bin="$(command -v hadoop-handler 2>/dev/null || echo "${SCRIPT_DIR}/hadoop-handler")"
        
        if [ -z "$action" ]; then
            clear
            echo -e "$DIVIDER"
            echo -e "  ${BCYAN}ACTION: System Service Integration (systemd)${NC}"
            echo -e "$DIVIDER"
            echo -e "  1. Enable Hadoop service on boot/login (systemd user unit)"
            echo -e "  2. Disable Hadoop service"
            echo -e "  3. View service status (systemctl --user status hadoop)"
            echo -e "  4. Start service via systemctl"
            echo -e "  5. Stop service via systemctl"
            echo -e "  6. Back to main menu"
            echo -e "$DIVIDER"
            read -p "  Select action [1-6]: " svc_choice
            case "$svc_choice" in
                1) action="enable" ;;
                2) action="disable" ;;
                3) action="status" ;;
                4) action="start" ;;
                5) action="stop" ;;
                *) return 0 ;;
            esac
        fi
        
        case "$action" in
            enable)
                echo -e "  [+] Generating user systemd unit: ${unit_file}..."
                mkdir -p "$unit_dir"
                cat << EOF > "$unit_file"
[Unit]
Description=Apache Hadoop Single-Node Services (HDFS & YARN)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="HADOOP_HOME=${HADOOP_HOME:-/opt/hadoop}"
Environment="JAVA_HOME=${JAVA_HOME}"
ExecStart=${hadoop_bin} start
ExecStop=${hadoop_bin} stop

[Install]
WantedBy=default.target
EOF
                systemctl --user daemon-reload
                systemctl --user enable hadoop.service
                echo -e "  ${GREEN}[✓] Hadoop service enabled!${NC}"
                echo -e "      Hadoop services will now automatically launch on user login."
                send_notification "Hadoop Handler" "Hadoop systemd user service enabled."
                ;;
            disable)
                echo -e "  [+] Disabling Hadoop systemd service..."
                systemctl --user stop hadoop.service 2>/dev/null || true
                systemctl --user disable hadoop.service 2>/dev/null || true
                rm -f "$unit_file"
                systemctl --user daemon-reload
                echo -e "  ${GREEN}[✓] Hadoop systemd service disabled and unit removed.${NC}"
                send_notification "Hadoop Handler" "Hadoop systemd service disabled."
                ;;
            status)
                systemctl --user status hadoop.service --no-pager
                ;;
            start)
                echo -e "  [+] Starting hadoop.service via systemctl..."
                systemctl --user start hadoop.service
                echo -e "  ${GREEN}[✓] Signal dispatched to systemd.${NC}"
                ;;
            stop)
                echo -e "  [+] Stopping hadoop.service via systemctl..."
                systemctl --user stop hadoop.service
                echo -e "  ${GREEN}[✓] Signal dispatched to systemd.${NC}"
                ;;
            *)
                echo -e "  ${RED}[!] Unknown service action: ${action}${NC}"
                ;;
        esac
    elif [ "$OS_NAME" = "Darwin" ]; then
        local plist_dir="$HOME/Library/LaunchAgents"
        local plist_file="${plist_dir}/in.adityapidurkar.hadoop.plist"
        local hadoop_bin="$(command -v hadoop-handler 2>/dev/null || echo "${SCRIPT_DIR}/hadoop-handler")"

        case "$action" in
            enable)
                mkdir -p "$plist_dir"
                cat << EOF > "$plist_file"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>in.adityapidurkar.hadoop</string>
    <key>ProgramArguments</key>
    <array>
        <string>${hadoop_bin}</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
EOF
                launchctl load "$plist_file" 2>/dev/null || true
                echo -e "  ${GREEN}[✓] LaunchAgent enabled for macOS.${NC}"
                send_notification "Hadoop Handler" "Hadoop LaunchAgent service enabled."
                ;;
            disable)
                launchctl unload "$plist_file" 2>/dev/null || true
                rm -f "$plist_file"
                echo -e "  ${GREEN}[✓] LaunchAgent disabled for macOS.${NC}"
                ;;
            *)
                echo -e "  ${YELLOW}Use 'enable' or 'disable' on macOS.${NC}"
                ;;
        esac
    fi
}

# 7. Check for Updates and Perform In-Place Self-Update
self_update() {
    clear
    echo -e "$DIVIDER"
    echo -e "  ${BCYAN}ACTION: Checking & Updating Hadoop Handler${NC}"
    echo -e "$DIVIDER\n"

    local updated=false

    if [ -d "$HOME/.hadoop-handler/.git" ]; then
        echo -e "  [+] Checking global installation in ~/.hadoop-handler..."
        (cd "$HOME/.hadoop-handler" && git pull origin main)
        chmod +x "$HOME/.hadoop-handler/hadoop-handler" "$HOME/.hadoop-handler/setup.sh" 2>/dev/null || true
        updated=true
    fi

    if [ -d "${SCRIPT_DIR}/.git" ] && [ "${SCRIPT_DIR}" != "$HOME/.hadoop-handler" ]; then
        echo -e "  [+] Pulling latest changes in ${SCRIPT_DIR}..."
        (cd "${SCRIPT_DIR}" && git pull origin main)
        chmod +x "${SCRIPT_DIR}/hadoop-handler" 2>/dev/null || true
        updated=true
    fi

    if command -v pip >/dev/null 2>&1 && pip list 2>/dev/null | grep -q "hadoop-handler"; then
        echo -e "  [+] Upgrading pip package..."
        pip install --upgrade hadoop-handler 2>/dev/null || true
        updated=true
    elif command -v python3 >/dev/null 2>&1 && python3 -m pip list 2>/dev/null | grep -q "hadoop-handler"; then
        echo -e "  [+] Upgrading python3 pip package..."
        python3 -m pip install --upgrade hadoop-handler 2>/dev/null || true
        updated=true
    fi

    rm -f "$HOME/.hadoop-handler/.version_cache" 2>/dev/null || true

    if [ "$updated" = "true" ]; then
        echo -e "\n  ${GREEN}[✓] Hadoop Handler is up to date!${NC}"
        send_notification "Hadoop Handler" "Hadoop Handler updated to the latest version."
    else
        echo -e "\n  ${YELLOW}[*] No git or pip package found to update.${NC}"
    fi
}

# 8. Shell Autocompletion
install_shell_completion() {
