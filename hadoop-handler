# Portable symlink resolution to find original install directory
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -h "$TARGET_FILE" ]; do
    DIR="$(dirname "$TARGET_FILE")"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ "$TARGET_FILE" != /* ]] && TARGET_FILE="$DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH}"

if command -v python3 >/dev/null 2>&1; then
    exec python3 -m hadoop_handler.cli "$@"
elif command -v python >/dev/null 2>&1; then
    exec python -m hadoop_handler.cli "$@"
else
    echo "[!] Error: Python 3 is required to run hadoop-handler v2.0." >&2
    exit 1
fi
