# 0. Diagnose Environment
diagnose_environment() {
    clear
    echo -e "$DIVIDER"
    echo -e "  ${BCYAN}ACTION: Diagnosing System Dependencies${NC}"
    echo -e "$DIVIDER\n"
    
    local missing_deps=()
    local repair_cmds=()
    
    echo -e "  ${GRAY}Scanning critical utilities...${NC}"
    
    local pkg_manager=""
    if [ "$OS_NAME" = "Linux" ]; then
        if command -v apt-get >/dev/null 2>&1; then
            pkg_manager="apt"
        elif command -v dnf >/dev/null 2>&1; then
            pkg_manager="dnf"
        elif command -v yum >/dev/null 2>&1; then
            pkg_manager="yum"
        elif command -v pacman >/dev/null 2>&1; then
            pkg_manager="pacman"
        elif command -v zypper >/dev/null 2>&1; then
            pkg_manager="zypper"
        fi
    elif [ "$OS_NAME" = "Darwin" ]; then
        if command -v brew >/dev/null 2>&1; then
            pkg_manager="brew"
        fi
    fi

    check_dependency() {
        local cmd=$1
        local pkg_apt=$2
        local pkg_dnf=$3
        local pkg_pacman=$4
        local pkg_brew=$5

        echo -ne "  - Checking for ${CYAN}${cmd}${NC}... "
        if command -v "$cmd" >/dev/null 2>&1; then
            echo -e "${GREEN}[OK]${NC}"
        else
            echo -e "${RED}[MISSING]${NC}"
            missing_deps+=("$cmd")
            case "$pkg_manager" in
                apt) [ -n "$pkg_apt" ] && repair_cmds+=("sudo apt-get install -y $pkg_apt") ;;
                dnf|yum) [ -n "$pkg_dnf" ] && repair_cmds+=("sudo $pkg_manager install -y $pkg_dnf") ;;
                pacman) [ -n "$pkg_pacman" ] && repair_cmds+=("sudo pacman -S --noconfirm $pkg_pacman") ;;
                brew) [ -n "$pkg_brew" ] && repair_cmds+=("brew install $pkg_brew") ;;
            esac
        fi
    }

    check_dependency "curl" "curl" "curl" "curl" "curl"
    check_dependency "tar" "tar" "tar" "tar" ""
    check_dependency "ssh" "openssh-client openssh-server" "openssh-clients openssh-server" "openssh" ""
    check_dependency "rsync" "rsync" "rsync" "rsync" "rsync"
    
    echo -ne "  - Checking for ${CYAN}Java Runtime (OpenJDK)${NC}... "
    if command -v java >/dev/null 2>&1; then
        local jv=$(java -version 2>&1 | head -n 1 | awk -F '"' '{print $2}')
        echo -e "${GREEN}[OK] (${jv})${NC}"
    else
        echo -e "${RED}[MISSING]${NC}"
        missing_deps+=("java")
        case "$pkg_manager" in
            apt) repair_cmds+=("sudo apt-get install -y openjdk-21-jdk") ;;
            dnf|yum) repair_cmds+=("sudo $pkg_manager install -y java-21-openjdk-devel") ;;
            pacman) repair_cmds+=("sudo pacman -S --noconfirm jre21-openjdk jdk21-openjdk") ;;
            brew) repair_cmds+=("brew install openjdk@21") ;;
        esac
    fi

    if [ "$OS_NAME" = "Linux" ]; then
        echo -ne "  - Checking for ${CYAN}SSH Daemon (sshd)${NC}... "
        if systemctl is-active --quiet ssh 2>/dev/null || systemctl is-active --quiet sshd 2>/dev/null; then
            echo -e "${GREEN}[RUNNING]${NC}"
        else
            echo -e "${YELLOW}[NOT RUNNING]${NC}"
            missing_deps+=("sshd_service")
            repair_cmds+=("sudo systemctl enable --now ssh 2>/dev/null || sudo systemctl enable --now sshd")
        fi
    fi

    echo -e "\n$DIVIDER"
    if [ ${#missing_deps[@]} -eq 0 ]; then
        echo -e "  ${GREEN}[✓] System scan complete! All dependencies are satisfied.${NC}"
        rm -f /tmp/hadoop_repair_cmds.txt /tmp/hadoop_repair_missing.txt
        return 0
    else
        echo -e "  ${YELLOW}[!] Diagnostics identified ${#missing_deps[@]} missing requirement(s).${NC}"
        printf "%s\n" "${repair_cmds[@]}" > /tmp/hadoop_repair_cmds.txt
        printf "%s\n" "${missing_deps[@]}" > /tmp/hadoop_repair_missing.txt
        return 1
    fi
}

apply_repairs() {
    local dry_run=$1
    if [ ! -f /tmp/hadoop_repair_cmds.txt ]; then
        echo -e "  ${YELLOW}No pending repairs found. Please run Diagnostics first.${NC}"
        return 0
    fi
    
    if [ "$dry_run" = "true" ]; then
        echo -e "\n  ${BCYAN}--- DRY RUN MODE ---${NC}"
        echo -e "  The following commands would be executed:"
        while read -r cmd; do
            echo -e "  > $cmd"
        done < /tmp/hadoop_repair_cmds.txt
        return 0
    fi

    echo -e "\n  ${BCYAN}ACTION: Applying Repairs${NC}"
    echo -e "  $DIVIDER"
    
    while read -r cmd; do
        echo -e "  ${GRAY}Executing: $cmd${NC}"
        eval "$cmd"
        if [ $? -ne 0 ]; then
            echo -e "  ${RED}[!] Repair step failed: $cmd${NC}"
            echo -e "  ${YELLOW}Aborting further repairs.${NC}"
            rm -f /tmp/hadoop_repair_cmds.txt /tmp/hadoop_repair_missing.txt
            return 1
        fi
    done < /tmp/hadoop_repair_cmds.txt
    
    echo -e "  ${GREEN}[✓] All repairs completed successfully!${NC}"
    rm -f /tmp/hadoop_repair_cmds.txt /tmp/hadoop_repair_missing.txt
    send_notification "Hadoop Handler" "System dependency repairs finished."
}

diagnose_and_repair() {
    diagnose_environment
    if [ -f /tmp/hadoop_repair_cmds.txt ]; then
        echo -e "\n  Do you want to apply these repairs now? (y/N/dryrun)"
        read -p "  > " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            apply_repairs "false"
        elif [[ "$confirm" == "dryrun" ]]; then
            apply_repairs "true"
        else
            echo -e "  ${YELLOW}Repairs cancelled.${NC}"
        fi
    fi
}

