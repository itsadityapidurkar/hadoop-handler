        if [ "$i" -eq "$selected" ]; then
            printf "\033[2K  %b▶%b %b[ %2d ] %s%b\n" "$BCYAN" "$NC" "$BGREEN" "$i" "${MENU_OPTIONS[$i]}" "$NC"
        else
            printf "\033[2K    %b[ %2d ]%b %s\n" "$GRAY" "$i" "$NC" "${MENU_OPTIONS[$i]}"
        fi
    done
    printf "\033[2K%b\n" "$DIVIDER"
