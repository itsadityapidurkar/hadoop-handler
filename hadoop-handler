CURRENT_VERSION="1.2.0"

# Colors for terminal output
RED='\033[0;31m'
BRED='\033[1;31m'
GREEN='\033[0;32m'
BGREEN='\033[1;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BCYAN='\033[1;36m'
YELLOW='\033[1;33m'
GRAY='\033[90m'
NC='\033[0m' # No Color

DIVIDER="${GRAY}─────────────────────────────────────────────────────────────────${NC}"

# Detect OS
OS_NAME=$(uname -s)

# Portable symlink resolution to find original install directory
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -h "$TARGET_FILE" ]; do
    DIR="$(dirname "$TARGET_FILE")"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ "$TARGET_FILE" != /* ]] && TARGET_FILE="$DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

# Send native desktop notification
send_notification() {
    local title="$1"
    local message="$2"
    if [ "$OS_NAME" = "Linux" ] && command -v notify-send >/dev/null 2>&1; then
        notify-send "$title" "$message" 2>/dev/null || true
    elif [ "$OS_NAME" = "Darwin" ]; then
        osascript -e "display notification \"$message\" with title \"$title\"" 2>/dev/null || true
    fi
}

# Resolve download URL for any given Hadoop version (mirrors with archive fallback)
resolve_hadoop_url() {
    local ver="$1"
    local tar_name="hadoop-${ver}.tar.gz"
    local mirror_url="https://downloads.apache.org/hadoop/common/hadoop-${ver}/${tar_name}"
    local archive_url="https://archive.apache.org/dist/hadoop/common/hadoop-${ver}/${tar_name}"

    if curl -s --head --max-time 3 "$mirror_url" 2>/dev/null | grep -E "200|302" >/dev/null; then
        echo "$mirror_url"
    else
        echo "$archive_url"
    fi
}

# Smooth download progress with Python or curl fallback
download_file() {
    local url="$1"
    local dest="$2"
    local title="${3:-Downloading}"

    if command -v python3 >/dev/null 2>&1; then
        python3 - << EOF
import os, sys, time, urllib.request

url = "$url"
dest = "$dest"
title = "$title"

headers = {'User-Agent': 'Hadoop-Handler/$CURRENT_VERSION'}
resume_byte_pos = 0
if os.path.exists(dest):
    resume_byte_pos = os.path.getsize(dest)

req = urllib.request.Request(url, headers=headers)
if resume_byte_pos > 0:
    req.add_header("Range", f"bytes={resume_byte_pos}-")

try:
    with urllib.request.urlopen(req, timeout=30) as resp:
        content_length = resp.headers.get('Content-Length')
        if resp.status == 206:
            total_size = resume_byte_pos + int(content_length) if content_length else 0
            mode = 'ab'
            downloaded = resume_byte_pos
        else:
            total_size = int(content_length) if content_length else 0
            mode = 'wb'
            downloaded = 0

        start_time = time.time()
        chunk_size = 131072
        bar_width = 24

        print(f"        {title}...")
        with open(dest, mode) as f:
            while True:
                chunk = resp.read(chunk_size)
                if not chunk:
                    break
                f.write(chunk)
                downloaded += len(chunk)
                elapsed = time.time() - start_time
                speed = (downloaded - resume_byte_pos) / elapsed if elapsed > 0 else 0

                if total_size > 0:
                    pct = min(100.0, (downloaded / total_size) * 100)
                    filled = int(bar_width * downloaded // total_size)
                    bar = '█' * filled + '░' * (bar_width - filled)
                    eta = (total_size - downloaded) / speed if speed > 0 else 0
                    eta_str = f"{int(eta // 60):02d}:{int(eta % 60):02d}"
                    sys.stdout.write(f"\r        [{bar}] {pct:5.1f}% ({downloaded/(1024*1024):.1f}/{total_size/(1024*1024):.1f} MB) {speed/(1024*1024):.1f} MB/s ETA {eta_str}")
                else:
                    sys.stdout.write(f"\r        Downloaded: {downloaded/(1024*1024):.1f} MB ({speed/(1024*1024):.1f} MB/s)")
                sys.stdout.flush()
        print()
    sys.exit(0)
except Exception as e:
    sys.stderr.write(f"\n        [!] Python download interrupted ({e}), falling back to curl...\n")
    sys.exit(1)
EOF
        if [ $? -eq 0 ] && [ -s "$dest" ]; then
            return 0
        fi
    fi

    # Fallback to curl with progress bar
    if command -v curl >/dev/null 2>&1; then
        echo -e "        Downloading via curl (progress bar enabled)..."
        curl -# -L -C - -o "$dest" "$url"
        return $?
    elif command -v wget >/dev/null 2>&1; then
        wget --progress=bar:force -c -O "$dest" "$url"
        return $?
    else
        echo -e "  ${RED}[!] Neither python3, curl, nor wget found.${NC}"
        return 1
    fi
}

# Check PyPI / GitHub for newer releases and display non-intrusive banner
check_version_banner() {
    local cache_file="$HOME/.hadoop-handler/.version_cache"
    local now=$(date +%s)
    local last_check=0

    mkdir -p "$HOME/.hadoop-handler" 2>/dev/null || true
    if [ -f "$cache_file" ]; then
        last_check=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
    fi

    if [ $((now - last_check)) -gt 43200 ]; then
        (
            local latest=$(curl -s --max-time 1.5 https://api.github.com/repos/itsadityapidurkar/hadoop-handler/releases/latest 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/' || echo "")
            if [ -n "$latest" ]; then
                echo "$latest" > "$cache_file"
            else
                latest=$(curl -s --max-time 1.5 https://pypi.org/pypi/hadoop-handler/json 2>/dev/null | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4 || echo "")
                [ -n "$latest" ] && echo "$latest" > "$cache_file"
            fi
        ) 2>/dev/null &
    fi

    if [ -f "$cache_file" ]; then
        local remote_ver=$(cat "$cache_file" 2>/dev/null | tr -d '[:space:]')
        if [ -n "$remote_ver" ] && [ "$remote_ver" != "$CURRENT_VERSION" ]; then
            echo -e "  ${YELLOW}* Note: Update available: ${CURRENT_VERSION} -> ${remote_ver}.${NC}"
            echo -e "    Run ${CYAN}hadoop-handler update${NC} to upgrade."
            echo -e "$DIVIDER"
        fi
    fi
}

# Load environment variables dynamically within the script execution context
load_env() {
    if [ -z "$HADOOP_HOME" ]; then
        if [ -d "/opt/hadoop" ]; then
            export HADOOP_HOME="/opt/hadoop"
        elif [ -d "/Users/Shared/hadoop" ]; then
            export HADOOP_HOME="/Users/Shared/hadoop"
        elif [ -d "$HOME/hadoop" ]; then
            export HADOOP_HOME="$HOME/hadoop"
        fi
    fi
    if [ -n "$HADOOP_HOME" ]; then
        export HADOOP_CONF_DIR="$HADOOP_HOME/etc/hadoop"
        export PATH="$PATH:$HADOOP_HOME/bin:$HADOOP_HOME/sbin"
        # Detect Java Home if not set
        if [ -z "$JAVA_HOME" ]; then
            if [ "$OS_NAME" = "Linux" ]; then
                if command -v java >/dev/null 2>&1; then
                    export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))
                fi
            elif [ "$OS_NAME" = "Darwin" ]; then
                if command -v java >/dev/null 2>&1; then
                    export JAVA_HOME=$(/usr/libexec/java_home 2>/dev/null || echo "")
                fi
            fi
        fi
    fi
}

pause_screen() {
    echo -e "\n$DIVIDER"
    echo -ne "  ${YELLOW}Press [Enter] to return to the main menu...${NC}"
    read -r
}

# ==============================================================================
#  JAVA DETECTION, SWITCHING & COMPATIBILITY CHECKER
# ==============================================================================

# Scan system for all installed JVMs
detect_installed_javas() {
    local seen_paths=()
    local jvms=()

    add_jvm() {
        local jpath="$1"
        [ -z "$jpath" ] && return
        if [ -d "$jpath" ] && [ -x "$jpath/bin/java" ]; then
            local real_path=$(cd -P "$jpath" 2>/dev/null && pwd)
            for s in "${seen_paths[@]}"; do
                [ "$s" = "$real_path" ] && return
            done
            seen_paths+=("$real_path")
            local ver_str=$("$real_path/bin/java" -version 2>&1 | head -n 1 | sed -E 's/.*version "([^"]+)".*/\1/')
            local major_ver=$(echo "$ver_str" | cut -d'.' -f1)
            [ "$major_ver" = "1" ] && major_ver=$(echo "$ver_str" | cut -d'.' -f2)
            jvms+=("${major_ver}|${ver_str}|${real_path}")
        fi
    }

    [ -n "$JAVA_HOME" ] && add_jvm "$JAVA_HOME"

    if command -v java >/dev/null 2>&1; then
        local bin_j=$(readlink -f "$(which java)" 2>/dev/null || which java)
        add_jvm "$(dirname "$(dirname "$bin_j")")"
    fi

    if [ -d "/usr/lib/jvm" ]; then
        for d in /usr/lib/jvm/*; do
            [ -d "$d" ] && add_jvm "$d"
        done
    fi

    if [ -d "/Library/Java/JavaVirtualMachines" ]; then
        for d in /Library/Java/JavaVirtualMachines/*/Contents/Home; do
            [ -d "$d" ] && add_jvm "$d"
        done
    fi

    for item in "${jvms[@]}"; do
        echo "$item"
    done
}

# Manage Java runtimes (list, switch, use)
manage_java() {
    local action="$1"
    local arg="$2"

    local jvm_records=()
    while IFS= read -r line; do
        [ -n "$line" ] && jvm_records+=("$line")
    done < <(detect_installed_javas)

    if [ "$action" = "list" ]; then
        clear
        echo -e "$DIVIDER"
        echo -e "  ${BCYAN}ACTION: Detected Java Runtimes (JVMs)${NC}"
        echo -e "$DIVIDER\n"
        printf "  %-7s %-12s %-45s %s\n" "INDEX" "VERSION" "PATH" "ACTIVE"
        echo -e "  -----------------------------------------------------------------"
        for idx in "${!jvm_records[@]}"; do
            IFS="|" read -r major ver path <<< "${jvm_records[$idx]}"
            local active=" "
            if [ "$path" = "$JAVA_HOME" ]; then
                active="${GREEN}[ACTIVE]${NC}"
            fi
            printf "  [%2d]    %-12s %-45s %b\n" "$((idx + 1))" "Java $major" "$path" "$active"
        done
        echo -e "$DIVIDER"
        return 0
    fi

    # Switch / Use action
    local chosen_path=""
    if [ -n "$arg" ]; then
        if [[ "$arg" =~ ^[0-9]+$ ]] && [ "$arg" -le "${#jvm_records[@]}" ] && [ "$arg" -gt 0 ]; then
            IFS="|" read -r _ _ chosen_path <<< "${jvm_records[$((arg - 1))]}"
        elif [ -d "$arg" ] && [ -x "$arg/bin/java" ]; then
            chosen_path="$arg"
        else
            for item in "${jvm_records[@]}"; do
                IFS="|" read -r major ver path <<< "$item"
                if [ "$major" = "$arg" ]; then
                    chosen_path="$path"
                    break
                fi
            done
        fi
    fi

    if [ -z "$chosen_path" ]; then
        clear
        echo -e "$DIVIDER"
        echo -e "  ${BCYAN}ACTION: Switch Java Runtime for Hadoop${NC}"
        echo -e "$DIVIDER\n"
        echo -e "  Available Java Runtimes on this system:"
        for idx in "${!jvm_records[@]}"; do
            IFS="|" read -r major ver path <<< "${jvm_records[$idx]}"
            local mark=" "
            [ "$path" = "$JAVA_HOME" ] && mark="${GREEN}[ACTIVE]${NC}"
            printf "    [ %d ] Java %-2s (%s) %b\n" "$((idx + 1))" "$major" "$path" "$mark"
        done
        echo -e "    [ 0 ] Cancel"
        echo -e "$DIVIDER"
        read -p "  Select Java runtime to use [1-${#jvm_records[@]}]: " pick
        if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -gt 0 ] && [ "$pick" -le "${#jvm_records[@]}" ]; then
            IFS="|" read -r _ _ chosen_path <<< "${jvm_records[$((pick - 1))]}"
        else
            echo -e "  Operation cancelled."
            return 0
        fi
    fi

    if [ -n "$chosen_path" ] && [ -d "$chosen_path" ]; then
        export JAVA_HOME="$chosen_path"
        echo -e "  [+] Setting JAVA_HOME=${GREEN}${chosen_path}${NC}"

        if [ -n "$HADOOP_HOME" ] && [ -f "${HADOOP_HOME}/etc/hadoop/hadoop-env.sh" ]; then
            sed -i.bak "s|^export JAVA_HOME=.*|export JAVA_HOME=${chosen_path}|g" "${HADOOP_HOME}/etc/hadoop/hadoop-env.sh" 2>/dev/null || \
            sed -i '' "s|^export JAVA_HOME=.*|export JAVA_HOME=${chosen_path}|g" "${HADOOP_HOME}/etc/hadoop/hadoop-env.sh" 2>/dev/null
            rm -f "${HADOOP_HOME}/etc/hadoop/hadoop-env.sh.bak"
            echo -e "  [+] Updated ${HADOOP_HOME}/etc/hadoop/hadoop-env.sh"
        fi

        local prof="$HOME/.bashrc"
        [[ "$SHELL" == */zsh ]] && prof="$HOME/.zshrc"
        if [ -f "$prof" ]; then
            sed -i.bak "s|^export JAVA_HOME=.*|export JAVA_HOME=\"${chosen_path}\"|g" "$prof" 2>/dev/null || \
            sed -i '' "s|^export JAVA_HOME=.*|export JAVA_HOME=\"${chosen_path}\"|g" "$prof" 2>/dev/null
            rm -f "${prof}.bak"
            echo -e "  [+] Updated ${prof}"
        fi

        echo -e "\n  ${GREEN}[✓] Active Java runtime switched successfully!${NC}"
        send_notification "Hadoop Handler" "Switched Hadoop Java runtime to ${chosen_path}."

        if command -v hadoop >/dev/null 2>&1; then
            echo ""
            check_compatibility "" ""
        fi
    fi
}

# Hadoop <-> Java Compatibility Matrix Checker
check_compatibility() {
    local hadoop_v="$1"
    local java_v="$2"

    if [ -z "$hadoop_v" ]; then
        if command -v hadoop >/dev/null 2>&1; then
            hadoop_v=$(hadoop version 2>/dev/null | head -n 1 | awk '{print $2}')
        else
            hadoop_v="3.4.2"
        fi
    fi

    if [ -z "$java_v" ]; then
        if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
            local j_str=$("$JAVA_HOME/bin/java" -version 2>&1 | head -n 1)
            java_v=$(echo "$j_str" | sed -E 's/.*version "([^"]+)".*/\1/' | cut -d'.' -f1)
            [ "$java_v" = "1" ] && java_v=$(echo "$j_str" | sed -E 's/.*version "([^"]+)".*/\1/' | cut -d'.' -f2)
        elif command -v java >/dev/null 2>&1; then
            local j_str=$(java -version 2>&1 | head -n 1)
            java_v=$(echo "$j_str" | sed -E 's/.*version "([^"]+)".*/\1/' | cut -d'.' -f1)
            [ "$java_v" = "1" ] && java_v=$(echo "$j_str" | sed -E 's/.*version "([^"]+)".*/\1/' | cut -d'.' -f2)
        else
            java_v="unknown"
        fi
    fi

    local h_major=$(echo "$hadoop_v" | cut -d'.' -f1)
    local h_minor=$(echo "$hadoop_v" | cut -d'.' -f2)
    local j_major=$(echo "$java_v" | cut -d'.' -f1)
    [ "$j_major" = "1" ] && j_major=$(echo "$java_v" | cut -d'.' -f2)

    echo -e "  Checking compatibility: Hadoop ${CYAN}${hadoop_v}${NC} <-> Java ${CYAN}${java_v}${NC}..."

    local compatible=true
    local reason=""
    local recommended=""

    if [ "$h_major" -ge 3 ] && [ "$h_minor" -ge 4 ]; then
        if [ "$j_major" -eq 8 ] || [ "$j_major" -eq 11 ] || [ "$j_major" -eq 17 ] || [ "$j_major" -eq 21 ]; then
            compatible=true
        elif [ "$j_major" -gt 21 ]; then
            compatible=false
            reason="Java $j_major is newer than officially validated LTS runtimes."
            recommended="Java 11, 17, or 21"
        else
            compatible=false
            reason="Hadoop 3.4+ requires at least Java 8."
            recommended="Java 11, 17, or 21"
        fi
    elif [ "$h_major" -eq 3 ] && [ "$h_minor" -eq 3 ]; then
        if [ "$j_major" -eq 8 ] || [ "$j_major" -eq 11 ] || [ "$j_major" -eq 17 ]; then
            compatible=true
        else
            compatible=false
            reason="Hadoop 3.3.x does not support Java $j_major (fails on Java 21+)."
            recommended="Java 8, 11, or 17"
        fi
    elif [ "$h_major" -eq 3 ] && [ "$h_minor" -le 2 ]; then
        if [ "$j_major" -eq 8 ] || [ "$j_major" -eq 11 ]; then
            compatible=true
        else
            compatible=false
            reason="Hadoop 3.0-3.2 fails on Java 17+ due to JVM module encapsulation (JEP 396/403)."
            recommended="Java 8 or Java 11"
        fi
    elif [ "$h_major" -eq 2 ]; then
        if [ "$j_major" -eq 7 ] || [ "$j_major" -eq 8 ]; then
            compatible=true
        else
            compatible=false
            reason="Hadoop 2.x only supports Java 7 or Java 8."
            recommended="Java 8"
        fi
    fi

    if [ "$compatible" = "true" ]; then
        echo -e "  ${GREEN}[✓] Compatible: Hadoop ${hadoop_v} is officially verified on Java ${java_v}.${NC}"
        return 0
    else
        echo -e "  ${RED}[!] Incompatibility Detected: ${reason}${NC}"
        echo -e "      ${YELLOW}Recommended runtime for Hadoop ${hadoop_v}: ${recommended}.${NC}"
        echo -e "      ${GRAY}Tip: Use 'hadoop-handler java switch' to select a compatible JVM.${NC}"
        return 1
    fi
}

# ==============================================================================
#  INSTALLATION & IN-PLACE UPGRADE / DOWNGRADE
# ==============================================================================

# 1. Install Hadoop with Dynamic Version Selector
install_hadoop() {
    clear
    load_env
    echo -e "$DIVIDER"
    echo -e "  ${BCYAN}ACTION: Installing Apache Hadoop (Dynamic Version Selector)${NC}"
    echo -e "$DIVIDER\n"

    local selected_ver="$1"
    if [ "$selected_ver" = "--version" ]; then
        selected_ver="$2"
    fi

    if [ -z "$selected_ver" ]; then
        echo -e "  Select Hadoop Version to Install:"
        echo -e "    1. 3.4.2 (Latest Stable, Java 8/11/17/21) [Default]"
        echo -e "    2. 3.4.1 (Java 8/11/17/21)"
        echo -e "    3. 3.3.6 (Production LTS, Java 8/11/17)"
        echo -e "    4. 3.3.5 (Java 8/11)"
        echo -e "    5. 3.2.4 (Legacy, Java 8/11)"
        echo -e "    6. Custom version"
        read -p "  Enter choice [1-6, default 1]: " vchoice
        case "$vchoice" in
            2) selected_ver="3.4.1" ;;
            3) selected_ver="3.3.6" ;;
            4) selected_ver="3.3.5" ;;
            5) selected_ver="3.2.4" ;;
            6) read -p "  Enter version string (e.g. 3.4.0): " selected_ver ;;
            *) selected_ver="3.4.2" ;;
        esac
    fi

    [ -z "$selected_ver" ] && selected_ver="3.4.2"
    echo -e "\n  Target Hadoop Version: ${GREEN}${selected_ver}${NC}"

    # Check / Detect Java Compatibility
    echo -e "\n  ${GRAY}[1/8]${NC} Validating Java runtime..."
    local detected_java_home=""
    if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
        detected_java_home="$JAVA_HOME"
    elif command -v java >/dev/null 2>&1; then
        detected_java_home=$(dirname $(dirname $(readlink -f $(which java) 2>/dev/null || which java)))
    fi

    if [ -n "$detected_java_home" ]; then
        local j_cur=$("$detected_java_home/bin/java" -version 2>&1 | head -n 1 | sed -E 's/.*version "([^"]+)".*/\1/' | cut -d'.' -f1)
        [ "$j_cur" = "1" ] && j_cur=$("$detected_java_home/bin/java" -version 2>&1 | head -n 1 | sed -E 's/.*version "([^"]+)".*/\1/' | cut -d'.' -f2)
        echo -e "        Active Java: ${CYAN}Java ${j_cur}${NC} (${detected_java_home})"
        
        check_compatibility "$selected_ver" "$j_cur" || {
            echo -e "\n  ${YELLOW}[!] Would you like to select an alternative installed Java? (y/N)${NC}"
            read -p "  > " switch_j
            if [[ "$switch_j" =~ ^[Yy]$ ]]; then
                manage_java "switch"
                load_env
                detected_java_home="$JAVA_HOME"
            fi
        }
    else
        echo -e "        ${YELLOW}[!] No Java detected. Attempting to install OpenJDK 21...${NC}"
        if [ "$OS_NAME" = "Linux" ]; then
            if command -v apt-get >/dev/null 2>&1; then
                sudo apt-get update && sudo apt-get install -y openjdk-21-jdk || return 1
            elif command -v dnf >/dev/null 2>&1; then
                sudo dnf install -y java-21-openjdk-devel || return 1
            elif command -v pacman >/dev/null 2>&1; then
                sudo pacman -S --noconfirm jre21-openjdk jdk21-openjdk || return 1
            fi
            detected_java_home=$(dirname $(dirname $(readlink -f $(which java))))
        elif [ "$OS_NAME" = "Darwin" ]; then
            brew install openjdk@21 || return 1
            detected_java_home=$(/usr/libexec/java_home -v 21 2>/dev/null || echo "")
        fi
    fi

    [ -z "$detected_java_home" ] && detected_java_home="/usr/lib/jvm/default-java"

    # Target Locations
    HADOOP_DEST="/opt/hadoop"
    HADOOP_DATA_DIR="/opt/hadoop_data"
    HADOOP_TMP_DIR="/opt/hadoop_tmp"
    HADOOP_TAR="hadoop-${selected_ver}.tar.gz"
    DOWNLOAD_URL=$(resolve_hadoop_url "$selected_ver")

    if [ "$OS_NAME" = "Darwin" ]; then
        if [[ "$HOME" == *" "* ]]; then
            HADOOP_DEST="/Users/Shared/hadoop"
            HADOOP_DATA_DIR="/Users/Shared/hadoop_data"
            HADOOP_TMP_DIR="/Users/Shared/hadoop_tmp"
        else
            HADOOP_DEST="$HOME/hadoop"
            HADOOP_DATA_DIR="$HOME/hadoopdata"
            HADOOP_TMP_DIR="$HOME/hadooptmp"
        fi
    fi

    # Create Directories
    echo -e "\n  ${GRAY}[2/8]${NC} Creating required system directories..."
    mkdir -p ~/Downloads
    if [ "$OS_NAME" = "Linux" ] && [[ "$HOME" == *" "* ]]; then
        sudo mkdir -p "${HADOOP_DATA_DIR}/namenode" "${HADOOP_DATA_DIR}/datanode" "${HADOOP_TMP_DIR}"
        sudo chown -R $USER:$USER "${HADOOP_DATA_DIR}" "${HADOOP_TMP_DIR}"
    else
        mkdir -p "${HADOOP_DATA_DIR}/namenode" "${HADOOP_DATA_DIR}/datanode" "${HADOOP_TMP_DIR}"
    fi

    # Download Hadoop tarball with smooth progress
    echo -e "\n  ${GRAY}[3/8]${NC} Retrieving Apache Hadoop ${selected_ver} tarball..."
    if [ -f "$HOME/Downloads/${HADOOP_TAR}" ]; then
        echo -e "        ${HADOOP_TAR} already cached in ~/Downloads. Skipping download."
    else
        download_file "${DOWNLOAD_URL}" "$HOME/Downloads/${HADOOP_TAR}" "Retrieving Apache Hadoop ${selected_ver}" || {
            echo -e "  ${RED}[!] Download failed for ${selected_ver}.${NC}"
            rm -f "$HOME/Downloads/${HADOOP_TAR}"
            return 1
        }
        send_notification "Hadoop Handler" "Apache Hadoop ${selected_ver} downloaded."
    fi

    # Extract and Relocate
    echo -e "\n  ${GRAY}[4/8]${NC} Extracting and relocating binaries..."
    if [ "$OS_NAME" = "Linux" ]; then
        [ -d "${HADOOP_DEST}" ] && sudo rm -rf "${HADOOP_DEST}"
        sudo tar -xzf "$HOME/Downloads/${HADOOP_TAR}" -C /opt || { echo -e "  ${RED}[!] Extraction failed.${NC}"; return 1; }
        sudo mv "/opt/hadoop-${selected_ver}" "${HADOOP_DEST}"
        sudo chown -R $USER:$USER "${HADOOP_DEST}"
    else
        [ -d "${HADOOP_DEST}" ] && rm -rf "${HADOOP_DEST}"
        if [[ "$HOME" == *" "* ]]; then
            tar -xzf "$HOME/Downloads/${HADOOP_TAR}" -C /Users/Shared || { echo -e "  ${RED}[!] Extraction failed.${NC}"; return 1; }
            mv "/Users/Shared/hadoop-${selected_ver}" "${HADOOP_DEST}"
        else
            tar -xzf "$HOME/Downloads/${HADOOP_TAR}" -C "$HOME/" || { echo -e "  ${RED}[!] Extraction failed.${NC}"; return 1; }
            mv "$HOME/hadoop-${selected_ver}" "${HADOOP_DEST}"
        fi
    fi
    echo -e "        Extraction completed successfully."
    send_notification "Hadoop Handler" "Apache Hadoop ${selected_ver} binaries extracted."

    # Configure SSH
    echo -e "\n  ${GRAY}[5/8]${NC} Configuring passwordless SSH keys..."
    if [ ! -f ~/.ssh/id_rsa ]; then
        ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa -N "" || return 1
    fi
    touch ~/.ssh/authorized_keys
    if ! grep -q "$(cat ~/.ssh/id_rsa.pub)" ~/.ssh/authorized_keys 2>/dev/null; then
        cat ~/.ssh/id_rsa.pub >> ~/.ssh/authorized_keys
    fi
    chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys
    if ! ssh-keygen -F localhost >/dev/null 2>&1; then
        ssh-keyscan -H localhost >> ~/.ssh/known_hosts 2>/dev/null
    fi

    # Configure Environment Variables
    echo -e "\n  ${GRAY}[6/8]${NC} Registering path variables in shell configuration..."
    SHELL_CONFIG=""
    [[ "$SHELL" == */zsh ]] && SHELL_CONFIG="$HOME/.zshrc" || SHELL_CONFIG="$HOME/.bashrc"

    ENV_MARKER="# --- HADOOP HANDLER ENVIRONMENT VARIABLES ---"
    if grep -q "$ENV_MARKER" "${SHELL_CONFIG}" 2>/dev/null; then
        echo -e "        Environment variables already present in ${SHELL_CONFIG}."
    else
        cat << EOF >> "${SHELL_CONFIG}"

$ENV_MARKER
export JAVA_HOME="${detected_java_home}"
export HADOOP_HOME="${HADOOP_DEST}"
export HADOOP_CONF_DIR="\${HADOOP_HOME}/etc/hadoop"
export HADOOP_COMMON_HOME="\${HADOOP_HOME}"
export HADOOP_HDFS_HOME="\${HADOOP_HOME}"
export HADOOP_MAPRED_HOME="\${HADOOP_HOME}"
export YARN_HOME="\${HADOOP_HOME}"
export HADOOP_COMMON_LIB_NATIVE_DIR="\${HADOOP_HOME}/lib/native"
export PATH="\$PATH:\$HADOOP_HOME/bin:\$HADOOP_HOME/sbin"
EOF
        echo -e "        Variables appended to ${SHELL_CONFIG}."
    fi

    # Configure XML Files
    echo -e "\n  ${GRAY}[7/8]${NC} Building cluster configuration files..."
    CONF_DIR="${HADOOP_DEST}/etc/hadoop"
    LOCAL_CONF_DIR="${HADOOP_HANDLER_CONF_DIR:-${SCRIPT_DIR}/configs}"

    if [ -d "$LOCAL_CONF_DIR" ]; then
        echo -e "        Loading XML templates from local configs directory..."
        cp "${LOCAL_CONF_DIR}/core-site.xml" "${CONF_DIR}/"
        cp "${LOCAL_CONF_DIR}/hdfs-site.xml" "${CONF_DIR}/"
        cp "${LOCAL_CONF_DIR}/mapred-site.xml" "${CONF_DIR}/"
        cp "${LOCAL_CONF_DIR}/yarn-site.xml" "${CONF_DIR}/"
        cp "${LOCAL_CONF_DIR}/workers" "${CONF_DIR}/"
        
        sed -i.bak "s|/home/YOUR_USERNAME/hadooptmp|${HADOOP_TMP_DIR}|g" "${CONF_DIR}/core-site.xml" 2>/dev/null || \
        sed -i "" "s|/home/YOUR_USERNAME/hadooptmp|${HADOOP_TMP_DIR}|g" "${CONF_DIR}/core-site.xml" 2>/dev/null
        
        sed -i.bak "s|file:///home/YOUR_USERNAME/hadoopdata|file://${HADOOP_DATA_DIR}|g" "${CONF_DIR}/hdfs-site.xml" 2>/dev/null || \
        sed -i "" "s|file:///home/YOUR_USERNAME/hadoopdata|file://${HADOOP_DATA_DIR}|g" "${CONF_DIR}/hdfs-site.xml" 2>/dev/null
        
        rm -f "${CONF_DIR}/core-site.xml.bak" "${CONF_DIR}/hdfs-site.xml.bak"
    else
        echo -e "        ${YELLOW}[!] Generating fallback configurations...${NC}"
        cat << EOF > "${CONF_DIR}/core-site.xml"
<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://localhost:9000</value>
    </property>
    <property>
        <name>hadoop.tmp.dir</name>
        <value>${HADOOP_TMP_DIR}</value>
    </property>
</configuration>
EOF

        cat << EOF > "${CONF_DIR}/hdfs-site.xml"
<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file://${HADOOP_DATA_DIR}/namenode</value>
    </property>
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file://${HADOOP_DATA_DIR}/datanode</value>
    </property>
</configuration>
EOF
        echo "localhost" > "${CONF_DIR}/workers"
    fi

    # Configure hadoop-env.sh
    sed -i.bak "s|^# export JAVA_HOME=.*|export JAVA_HOME=${detected_java_home}|g" "${CONF_DIR}/hadoop-env.sh" 2>/dev/null || \
    sed -i "" "s|^# export JAVA_HOME=.*|export JAVA_HOME=${detected_java_home}|g" "${CONF_DIR}/hadoop-env.sh" 2>/dev/null

    # Format NameNode
    echo -e "\n  ${GRAY}[8/8]${NC} Formatting HDFS NameNode system..."
    "${HADOOP_DEST}/bin/hdfs" namenode -format -force

    load_env

    echo -e "\n  ${GREEN}[✓] Installation of Hadoop ${selected_ver} completed successfully!${NC}"
    echo -e "      Reload your shell profile: ${YELLOW}source ${SHELL_CONFIG}${NC}"
    send_notification "Hadoop Handler" "Hadoop ${selected_ver} installation completed."
}

# In-Place Upgrade / Downgrade (Preserves HDFS Data Blocks)
upgrade_hadoop() {
    clear
    load_env
    echo -e "$DIVIDER"
    echo -e "  ${BCYAN}ACTION: In-Place Hadoop Upgrade / Downgrade${NC}"
    echo -e "$DIVIDER\n"

    if [ -z "$HADOOP_HOME" ] || [ ! -d "$HADOOP_HOME" ]; then
        echo -e "  ${RED}[!] Error: No active Hadoop installation found. Please run Install first.${NC}"
        return 1
    fi

    local current_ver=$(hadoop version 2>/dev/null | head -n 1 | awk '{print $2}')
    [ -z "$current_ver" ] && current_ver="3.4.2"
    echo -e "  Current Hadoop Version: ${CYAN}${current_ver}${NC}"

    local target_ver="$1"
    if [ -z "$target_ver" ]; then
        echo -e "\n  Select Target Hadoop Version to Migrate To:"
        echo -e "    1. 3.4.2 (Latest Stable, Java 8/11/17/21)"
        echo -e "    2. 3.4.1 (Java 8/11/17/21)"
        echo -e "    3. 3.3.6 (LTS Production, Java 8/11/17)"
        echo -e "    4. 3.3.5 (Java 8/11)"
        echo -e "    5. 3.2.4 (Legacy, Java 8/11)"
        echo -e "    6. Custom version"
        echo -e "    7. Cancel"
        read -p "  Enter choice [1-7]: " ver_choice
        case "$ver_choice" in
            1) target_ver="3.4.2" ;;
            2) target_ver="3.4.1" ;;
            3) target_ver="3.3.6" ;;
            4) target_ver="3.3.5" ;;
            5) target_ver="3.2.4" ;;
            6) read -p "  Enter target version (e.g. 3.4.0): " target_ver ;;
            *) echo -e "  Migration cancelled."; return 0 ;;
        esac
    fi

    if [ "$current_ver" = "$target_ver" ]; then
        echo -e "  ${YELLOW}[*] Cluster is already running Hadoop ${target_ver}.${NC}"
        return 0
    fi

    echo -e "\n  Target Hadoop Version: ${GREEN}${target_ver}${NC}"

    # Verify Java compatibility
    check_compatibility "$target_ver" "" || {
        echo -e "\n  ${YELLOW}[!] Warning: Current Java runtime may not be compatible with Hadoop ${target_ver}.${NC}"
        read -p "  Do you want to proceed anyway? (y/N): " ignore_compat
        if [[ ! "$ignore_compat" =~ ^[Yy]$ ]]; then
            echo -e "  Migration aborted. Please run 'hadoop-handler java switch' first."
            return 1
        fi
    }

    echo -e "\n  ${GRAY}[1/5]${NC} Stopping active cluster daemons..."
    stop_services >/dev/null 2>&1 || true

    echo -e "  ${GRAY}[2/5]${NC} Backing up cluster XML configurations..."
    local backup_dir="/tmp/hadoop_conf_backup_$(date +%s)"
    mkdir -p "$backup_dir"
    local conf_src="${HADOOP_HOME}/etc/hadoop"
    for f in core-site.xml hdfs-site.xml mapred-site.xml yarn-site.xml workers; do
        [ -f "${conf_src}/$f" ] && cp "${conf_src}/$f" "$backup_dir/"
    done
    echo -e "        Configuration backup saved to ${backup_dir}."

    local target_tar="hadoop-${target_ver}.tar.gz"
    local download_url=$(resolve_hadoop_url "$target_ver")
    echo -e "\n  ${GRAY}[3/5]${NC} Retrieving Hadoop ${target_ver}..."
    if [ ! -f "$HOME/Downloads/${target_tar}" ]; then
        download_file "$download_url" "$HOME/Downloads/${target_tar}" "Downloading Hadoop ${target_ver}" || {
            echo -e "  ${RED}[!] Download failed for ${target_ver}.${NC}"
            return 1
        }
    else
        echo -e "        Using cached archive: ~/Downloads/${target_tar}"
    fi

    echo -e "\n  ${GRAY}[4/5]${NC} Relocating binaries (preserving HDFS blocks)..."
    local hadoop_dest="${HADOOP_HOME}"
    if [ "$OS_NAME" = "Linux" ]; then
        sudo rm -rf "${hadoop_dest}"
        sudo tar -xzf "$HOME/Downloads/${target_tar}" -C /opt || { echo -e "  ${RED}[!] Extraction failed.${NC}"; return 1; }
        sudo mv "/opt/hadoop-${target_ver}" "${hadoop_dest}"
        sudo chown -R $USER:$USER "${hadoop_dest}"
    else
        rm -rf "${hadoop_dest}"
        tar -xzf "$HOME/Downloads/${target_tar}" -C "$HOME/" || { echo -e "  ${RED}[!] Extraction failed.${NC}"; return 1; }
        mv "$HOME/hadoop-${target_ver}" "${hadoop_dest}"
    fi

    echo -e "\n  ${GRAY}[5/5]${NC} Restoring cluster XML configurations..."
    local new_conf="${hadoop_dest}/etc/hadoop"
    cp "$backup_dir"/* "$new_conf/" 2>/dev/null || true
    
    if [ -n "$JAVA_HOME" ]; then
        sed -i.bak "s|^# export JAVA_HOME=.*|export JAVA_HOME=${JAVA_HOME}|g" "${new_conf}/hadoop-env.sh" 2>/dev/null || \
        sed -i '' "s|^# export JAVA_HOME=.*|export JAVA_HOME=${JAVA_HOME}|g" "${new_conf}/hadoop-env.sh" 2>/dev/null
    fi

    rm -rf "$backup_dir"

    echo -e "\n  ${GREEN}[✓] In-place migration to Hadoop ${target_ver} successful!${NC}"
    echo -e "      (Existing HDFS data blocks and cluster settings were preserved)."
    send_notification "Hadoop Handler" "Hadoop migrated to version ${target_ver}."

    read -p "  Do you want to start cluster services now? (Y/n): " start_now
    if [[ ! "$start_now" =~ ^[Nn]$ ]]; then
        start_services
    fi
}

# 2. Verify Hadoop Installation
verify_hadoop() {
